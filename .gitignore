# Cerebrate 脑虫 .gitignore

# ───────── 环境配置 (包含 API 密钥) ─────────
.env

# ───────── 运行时数据 ─────────
# 记忆数据 (运行时数据，不入库)
# 注意: 实际路径在 cerebrate/memory/ 下，需带包前缀才能生效
cerebrate/memory/personal/
cerebrate/memory/swarm/
cerebrate/memory/knowledge/
cerebrate/memory/agents/
cerebrate/memory/evolution/
cerebrate/memory/usage/
cerebrate/memory/events/
cerebrate/memory/.archived/
cerebrate/memory/_semantic_index*.json
cerebrate/memory/_semantic_index.kb_index.json
cerebrate/memory/chroma_data/

# 允许明确导出的脑虫养分种子入库
!cerebrate/memory/seeds/
!cerebrate/memory/seeds/*.jsonl

# ───────── 编译产物 / 二进制文件 ─────────
__pycache__/
*.py[cod]
*.so
*.dll
*.dylib
*.exe
*.class

# ───────── 打包构建 ─────────
*.egg-info/
dist/
build/
*.whl
*.egg/

# ───────── IDE / 编辑器 ─────────
.vscode/
.idea/
.claude/settings.local.json

# ───────── OS 系统文件 ─────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ───────── 日志 ─────────
*.log
