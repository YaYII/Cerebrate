# Cerebrate 脑虫 .gitignore

# ───────── 环境配置 (包含 API 密钥) ─────────
.env

# ───────── 运行时数据 ─────────
# 记忆数据 (运行时数据，不入库)
# 注意: 实际路径在 cerebrate/memory/ 下，需带包前缀才能生效
cerebrate/memory/personal/
cerebrate/memory/swarm/
cerebrate/memory/knowledge/
cerebrate/memory/agents/
cerebrate/memory/evolution/
cerebrate/memory/usage/
cerebrate/memory/events/
cerebrate/memory/.archived/
cerebrate/memory/_semantic_index*.json
cerebrate/memory/_semantic_index.kb_index.json
cerebrate/memory/chroma_data/

# 允许明确导出的脑虫养分种子入库
!cerebrate/memory/seeds/
!cerebrate/memory/seeds/*.jsonl

# ───────── 编译产物 / 二进制文件 ─────────
__pycache__/
*.py[cod]
*.so
*.dll
*.dylib
*.exe
*.class

# ───────── 打包构建 ─────────
*.egg-info/
dist/
build/
*.whl
*.egg/

# ───────── IDE / 编辑器 ─────────
.vscode/
.idea/
.claude/settings.local.json
.codegraph/

# ───────── OS 系统文件 ─────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ───────── 日志 ─────────
*.log

# Docker 默认 bind mount 目录（运行时数据，不入库）
/data/

# 含真实 token 的本地 MCP 配置（开源参考 docs/DEPLOY.md 的占位示例）
mcp.json

# deepseek 等第三方 AI 工具的本地状态（含本地路径，不入库）
.deepseek/

# 知识库导出快照（运行时数据，本地浏览用，不入库）
.虫群/

# ───────── 会话文件 / 临时脚本 ─────────
SESSION.md
_restart.py

# ───────── 知识吸入缓存 ─────────
.ingest_cache.json

# ───────── dsh-plugins 文档 / 个人资料（退出 git 管理，2026-08-26）─────────
dsh-plugins/docs/

# ───────── node_modules（插件依赖，退出 git 管理，2026-08-26）─────────
node_modules/

# ───────── 配置备份文件（*.bak-时间戳）─────────
*.bak-*

# ── 2026-10-06 新增：本地实验与敏感数据目录（严禁提交，本仓库为公开仓库）──
# crawler-lab：爬虫实验（含企业核查报告、小说数据、865MB vendor 副本）
dsh-plugins/crawler-lab/
# company-osint：企业情报档案（含公司尽调结果），属敏感数据
dsh-plugins/company-osint/
# ai-fetch：网页抓取工具（含 vendor），待整理后再决定是否入库
dsh-plugins/ai-fetch/
# 工具本地配置与生成产物
dsh-plugins/.commandcode/
dsh-plugins/*/.code-review/
