{
  "name": "dsh-apple-glass-skin",
  "version": "0.1.0",
  "description": "Apple glass-morphism skin for DeepSeek Harness web UI: translucent frosted panels over a macOS-style gradient backdrop, light and dark variants, durable per-browser persistence.",
  "license": "MIT",
  "author": "yangying",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepseek-ai/deepseek-harness.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "dsh-plugin",
    "theme",
    "skin",
    "glass",
    "glassmorphism",
    "apple",
    "macos",
    "web-ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2"
  }
}