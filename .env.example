# ============================================
# Cerebrate 脑虫配置 — 虫群的灵魂与免疫系统
# ============================================
# 复制此文件为 .env 并填入实际值

# --- LLM 配置 (脑虫的大脑) ---
# 脑虫使用 LLM 来: 验证记忆质量、过滤有毒内容、自动总结提炼
# 至少配置一个 LLM 提供商
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxx  # 备选

# 使用的模型 (默认即可)
CEREBRATE_LLM_PROVIDER=anthropic
CEREBRATE_LLM_MODEL=claude-sonnet-4-6

# --- 免疫系统配置 ---
# 是否在写入虫群前进行 LLM 内容安全检查
CEREBRATE_IMMUNE_ENABLED=true
# 安全阈值: 0=不检查, 1=最严格
CEREBRATE_IMMUNE_THRESHOLD=0.7

# --- 项目配置 ---
# 当前项目标识 (AI 智能体会自动设置)
# CEREBRATE_PROJECT_ID=cerebrate
# CEREBRATE_PROJECT_NAME=Cerebrate脑虫

# --- 进化配置 ---
CEREBRATE_EVOLUTION_ENABLED=true
CEREBRATE_EVOLUTION_INTERVAL=24
# 记忆半衰期 (天)
CEREBRATE_DECAY_HALF_LIFE=30

# --- 语言 ---
CEREBRATE_LANGUAGE=简体中文

# --- Embedding / 感知系统 ---
# 默认 false: 只使用本地已缓存 BGE；不可用时自动切换 deterministic hash embedding
CEREBRATE_EMBEDDING_ALLOW_DOWNLOAD=false
CEREBRATE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CEREBRATE_HASH_EMBEDDING_DIM=384

# --- HTTP Brain Server ---
# 注意: Docker 部署时容器内部的 HOST/PORT/数据路径由 docker-compose.yml 的 environment 段钉死，
# 此处的 SERVER_HOST/SERVER_URL 仅对「本地裸跑」和「客户端连接」生效。
CEREBRATE_SERVER_HOST=127.0.0.1
CEREBRATE_SERVER_PORT=8765
# CLI / SDK / MCP 客户端默认连接地址（连容器时改为容器宿主机地址，如 http://192.168.1.10:8765）
CEREBRATE_SERVER_URL=http://127.0.0.1:8765

# --- 鉴权令牌 (Bearer token) ---
# 服务端: 非空则对所有请求强制校验 Authorization: Bearer <token>；留空=不鉴权（仅限可信本地开发）。
# 客户端: CLI / MCP 自动用同名变量注入请求头，必须与服务端一致。
# 容器部署务必设置一个强随机值，例如: openssl rand -hex 32
CEREBRATE_SERVER_TOKEN=
