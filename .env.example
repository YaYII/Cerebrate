# ============================================
# Cerebrate 脑虫配置 — 虫群的灵魂与免疫系统
# ============================================
# 复制此文件为 .env 并填入实际值

# --- LLM 配置 (脑虫的大脑) ---
# 脑虫使用 LLM 来: 验证记忆质量、过滤有毒内容、自动总结提炼
# 支持: anthropic / openai / deepseek
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxx

# 使用的模型 (推荐: deepseek-v4-pro，顶级推理能力)
# deepseek-chat 和 deepseek-reasoner 将于 2026/07/24 废弃，请迁移至 v4 系列
CEREBRATE_LLM_PROVIDER=deepseek
CEREBRATE_LLM_MODEL=deepseek-v4-pro

# --- 免疫系统配置 ---
# 是否在写入虫群前进行 LLM 内容安全检查
CEREBRATE_IMMUNE_ENABLED=true
# 安全阈值: 0=不检查, 1=最严格
CEREBRATE_IMMUNE_THRESHOLD=0.7

# --- 项目配置 ---
# 当前项目标识 (AI 智能体会自动设置)
# CEREBRATE_PROJECT_ID=cerebrate
# CEREBRATE_PROJECT_NAME=Cerebrate脑虫

# --- 进化配置 ---
CEREBRATE_EVOLUTION_INTERVAL=24
# 记忆半衰期 (天)
CEREBRATE_DECAY_HALF_LIFE=30

# --- 记忆质量配置 ---
# 记忆内容的最小 token 数。低于此值的记忆被驳回。
# 防止碎片化/无信息量的记忆污染检索结果。
CEREBRATE_MEMORY_MIN_TOKENS=500
CEREBRATE_LANGUAGE=简体中文

# --- Embedding / 感知系统 ---
# ⚠️ 维度一致性警告（必须遵守）:
#   CEREBRATE_EMBEDDING_MODEL 必须与已有 ChromaDB 数据的向量维度一致。
#   Docker 目标部署（docker-compose.yml）默认 BAAI/bge-small-zh-v1.5 (512 维)，
#   现有生产数据也是 512 维。若改为 bge-m3 (1024 维)，core/storage.py 会因
#   embedding function mismatch 执行 delete_collection 清空全部向量数据！
#   切换模型前先确认维度，或接受全量重建。
CEREBRATE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 默认 false: 只使用本地已缓存 BGE；不可用时自动切换 deterministic hash embedding
CEREBRATE_EMBEDDING_ALLOW_DOWNLOAD=false
CEREBRATE_EMBEDDING_MAX_LENGTH=8192
# 向量嵌入摘要长度（字符数）: 嵌入文本 = title + 前 N 字摘要。
# 向量是定位器不是全文搜索引擎，嵌入摘要而非全文可大幅提升检索精度，
# 避免"偶然提到关键词"的无关文档被召回。默认 1000 字符 ≈ 600 tokens。
CEREBRATE_EMBEDDING_SUMMARY_CHARS=1000
CEREBRATE_HASH_EMBEDDING_DIM=1024

# --- 文档分块配置 ---
# 长文档自动分块存储，按标题/段落/等长切割
CEREBRATE_CHUNK_ENABLED=true
CEREBRATE_CHUNK_MAX_CHARS=8000
CEREBRATE_CHUNK_OVERLAP_CHARS=100
CEREBRATE_CHUNK_MIN_CHARS=200

# --- ReRanker 重排序（可选，增强检索精度）---
# 使用交叉编码器对粗搜结果精排；默认模型 BAAI/bge-reranker-v2-m3
CEREBRATE_RERANKER_ENABLED=true
CEREBRATE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- HTTP Brain Server ---
# 注意: Docker 部署时容器内部的 HOST/PORT/数据路径由 docker-compose.yml 的 environment 段钉死，
# 此处的 SERVER_HOST/SERVER_URL 仅对「本地裸跑」和「客户端连接」生效。
CEREBRATE_SERVER_HOST=127.0.0.1
CEREBRATE_SERVER_PORT=8765
# CLI / SDK / MCP 客户端默认连接地址
#   - 本机部署/开发: 用 127.0.0.1:8765（回环，仅本机可访问）
#   - 远程客户端（同事/其他设备）: 必须用公网地址，如 https://<ngrok域名>/cerebrate（本机 127.0.0.1 对方连不到）
CEREBRATE_SERVER_URL=http://127.0.0.1:8765

# --- 鉴权令牌 (Bearer token) ---
# 服务端: 非空则对所有请求强制校验 Authorization: Bearer <token>；留空=不鉴权（仅限可信本地开发）。
# 客户端: CLI / MCP 自动用同名变量注入请求头，必须与服务端一致。
# 容器部署务必设置一个强随机值，例如: openssl rand -hex 32
CEREBRATE_SERVER_TOKEN=

# --- Docker 数据目录 (bind mount) ---
# 容器记忆数据挂载到宿主机的真实目录，数据与程序分离：升级镜像/重装 Docker 不丢，
# 换电脑只需拷走该目录再挂载。默认项目内 ./data；
# 生产建议改为独立绝对路径（放在大容量盘/便于备份处），如 /home/<user>/cerebrate-data
CEREBRATE_DATA_DIR=./data

# --- Docker 容器 UID/GID ---
# 容器内 cerebrate 用户的 UID/GID，应与宿主机上 CEREBRATE_DATA_DIR 的属主一致
CEREBRATE_UID=1000
CEREBRATE_GID=1000
